---
import "./Header.css";
import {
  PHONE_NUMBER,
  PHONE_NUMBER_MASK,
  ADDRESS,
  GOOGLE_MAPS_LINK,
} from "@/constants";
import Popup from "../Popup/Popup.astro";
---

<!-- ======= Header ======= -->
<header id="header" class="fixed-top d-flex flex-column align-items-center">
  <div
    id="header-top"
    class="container-fluid d-flex align-items-center justify-content-between"
  >
    <div class="logo">
      <a href="/">
        <img class="logo-img" src="assets/img/logo.png" alt="logo" />
        <img class="logo-img-dark" src="assets/img/logo-dark.png" alt="logo" />
      </a>
    </div>

    <div class="contact-info d-none d-lg-flex align-items-center me-4">
      <div class="address me-4">
        <i class="bi bi-geo-alt"></i>
        <span>{ADDRESS}</span>
      </div>
      <div class="phone text-bold">
        <i class="bi bi-telephone"></i>
        <a href=`tel:${PHONE_NUMBER}`>{PHONE_NUMBER_MASK}</a>
      </div>
    </div>

    <div class="d-flex align-items-center">
      <a id="appointment-button" class="getstarted scrollto appointment-button"
        >Записатися на прийом</a
      >
      <a href="tel:+380441234567" class="pulse-button d-lg-none">
        <i class="bi bi-telephone-fill"></i>
      </a>

      <nav id="navbar-mobile" class="navbar d-block d-lg-none">
        <ul>
          <li>
            <a class="nav-link scrollto" href="#services">Послуги та ціни</a>
          </li>
          <li><a class="nav-link scrollto" href="#counts">Чому ми?</a></li>
          <li><a class="nav-link scrollto" href="#warranty">Гарантії</a></li>
          <li>
            <a class="nav-link scrollto" href="#testimonials">Відгуки</a>
          </li>
          <li>
            <a class="nav-link scrollto" href="#portfolio">Наші роботи</a>
          </li>
          <li><a class="nav-link scrollto" href="#contact">Контакти</a></li>
          <li class="contact-info-mobile mx-auto mt-4">
            <a class="nav-link" href={GOOGLE_MAPS_LINK}>
              <i class="bi bi-geo-alt"></i>
              {ADDRESS}
            </a>
          </li>
          <li class="contact-info-mobile mx-auto">
            <a class="nav-link" href=`tel:${PHONE_NUMBER}`>
              <i class="bi bi-telephone"></i>
              {PHONE_NUMBER_MASK}
            </a>
          </li>
        </ul>
        <i class="bi bi-list mobile-nav-toggle"></i>
      </nav>
    </div>
  </div>

  <div id="header-bottom" class="container-fluid d-none d-lg-block">
    <nav id="navbar-desktop" class="navbar">
      <ul>
        <li>
          <a class="nav-link scrollto" href="#services">Послуги та ціни</a>
        </li>
        <li><a class="nav-link scrollto" href="#counts">Чому ми?</a></li>
        <li><a class="nav-link scrollto" href="#warranty">Гарантії</a></li>
        <li>
          <a class="nav-link scrollto" href="#testimonials">Відгуки</a>
        </li>
        <li>
          <a class="nav-link scrollto" href="#portfolio">Наші роботи</a>
        </li>
        <li><a class="nav-link scrollto" href="#contact">Контакти</a></li>
      </ul>
    </nav>
  </div>
</header><!-- End Header -->

<Popup />

<style>
  #header .logo-img {
    width: 204px;
    height: 40px;
  }

  #header .logo-img-dark {
    width: 204px;
    height: 40px;
    display: none;
  }

  #header.header-scrolled .logo-img-dark {
    display: block;
  }

  #header.header-scrolled .logo-img {
    display: none;
  }

  /* Стили для контактной информации */
  .contact-info {
    font-size: 14px;
  }

  .contact-info i {
    margin-right: 8px;
    color: var(--color-primary);
  }

  .contact-info a {
    color: inherit;
    text-decoration: none;
    transition: color 0.3s;
  }

  .contact-info a:hover {
    color: var(--color-primary);
  }

  /* Стили для мобильной контактной информации */
  .contact-info-mobile a {
    font-size: 14px;
    padding: 10px 15px;
  }

  .contact-info-mobile i {
    margin-right: 8px;
    color: var(--color-primary);
  }
</style>
