---
import "./Header.css";
---

<!-- ======= Header ======= -->
<header id="header" class="fixed-top d-flex flex-column align-items-center">
  <div
    id="header-top"
    class="container-fluid d-flex align-items-center justify-content-between"
  >
    <div class="logo">
      <img class="logo-img" src="assets/img/logo.png" alt="logo" />
      <img class="logo-img-dark" src="assets/img/logo-dark.png" alt="logo" />
    </div>

    <!-- Кнопка записи -->
    <div class="d-flex align-items-center">
      <a class="getstarted scrollto appointment-button" href="#contact">Записатися на прийом</a>
      <!-- Мобильная навигация -->
      <nav id="navbar" class="navbar d-block d-lg-none">
        <ul>
          <!-- <li><a class="nav-link scrollto active" href="#hero">Головна</a></li> -->
          <li>
            <a class="nav-link scrollto" href="#services">Послуги та ціни</a>
          </li>
          <li><a class="nav-link scrollto" href="#counts">Чому ми?</a></li>
          <li><a class="nav-link scrollto" href="#warranty">Гарантії</a></li>
          <li>
            <a class="nav-link scrollto" href="#testimonials">Відгуки</a>
          </li>
          <li>
            <a class="nav-link scrollto" href="#portfolio">Наші роботи</a>
          </li>
          <li><a class="nav-link scrollto" href="#contact">Контакти</a></li>
        </ul>
        <i class="bi bi-list mobile-nav-toggle"></i>
      </nav>
    </div>
  </div>

  <!-- Десктопная навигация -->
  <div id="header-bottom" class="container-fluid d-none d-lg-block">
    <nav id="navbar-desktop" class="navbar">
      <ul>
        <!-- <li><a class="nav-link scrollto active" href="#hero">Головна</a></li> -->
        <li>
          <a class="nav-link scrollto" href="#services">Послуги та ціни</a>
        </li>
        <li><a class="nav-link scrollto" href="#counts">Чому ми?</a></li>
        <li><a class="nav-link scrollto" href="#warranty">Гарантії</a></li>
        <li>
          <a class="nav-link scrollto" href="#testimonials">Відгуки</a>
        </li>
        <li>
          <a class="nav-link scrollto" href="#portfolio">Наші роботи</a>
        </li>
        <li><a class="nav-link scrollto" href="#contact">Контакти</a></li>
      </ul>
    </nav>
  </div>
</header><!-- End Header -->

<style>
  #header .logo-img {
    width: 204px;
    height: 40px;
  }

  #header .logo-img-dark {
    width: 204px;
    height: 40px;
    display: none;
  }

  #header.header-scrolled .logo-img-dark {
    display: block;
  }

  #header.header-scrolled .logo-img {
    display: none;
  }
</style>
