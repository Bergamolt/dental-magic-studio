      <div class="col-lg-12 d-flex justify-content-center">
        <ul id="portfolio-flters">
          <li data-filter="*" class="filter-active">Все</li>
          <li data-filter=".filter-vinir">Вініри</li>
          <li data-filter=".filter-brackets">Брекети</li>
          <li data-filter=".filter-koronki">Коронки</li>
          <li data-filter=".filter-rest">Художня реставрація</li>
          <li data-filter=".filter-hygiene">Професійна гігієна</li>
          <li data-filter=".filter-karies">Лікування карієсу</li>
