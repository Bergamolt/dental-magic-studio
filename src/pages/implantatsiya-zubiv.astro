---
import FormSection from "@/components/FormSection/FormSection.astro";
import LoadScripts from "@/components/LoadScripts.astro";
---

<!doctype html>
<html lang="uk">
  <head>
    <meta charset="utf-8" />
    <meta content="width=device-width, initial-scale=1.0" name="viewport" />

    <title>Імплантація зубів - Dental Magic Studio</title>
    <meta content="" name="description" />

    <link
      rel="alternate"
      hreflang="uk-UA"
      href="https://drkravchenko.com.ua/implantatsiya-zubiv"
    />

    <!-- Favicons -->
    <link href="/assets/img/favicon.png" rel="icon" />
    <link href="/assets/img/apple-touch-icon.png" rel="apple-touch-icon" />

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Open+Sans:wght@300;400&family=Yanone+Kaffeesatz:wght@200;400&display=swap"
      rel="stylesheet"
    />

    <!-- Vendor CSS Files -->
    <link href="/assets/vendor/aos/aos.css" rel="stylesheet" />
    <link
      href="/assets/vendor/bootstrap/css/bootstrap.min.css"
      rel="stylesheet"
    />
    <link
      href="/assets/vendor/bootstrap-icons/bootstrap-icons.css"
      rel="stylesheet"
    />
    <link
      href="/assets/vendor/boxicons/css/boxicons.min.css"
      rel="stylesheet"
    />
    <link
      href="/assets/vendor/glightbox/css/glightbox.min.css"
      rel="stylesheet"
    />
    <link href="/assets/vendor/remixicon/remixicon.css" rel="stylesheet" />
    <link href="/assets/vendor/swiper/swiper-bundle.min.css" rel="stylesheet" />

    <!-- Template Main CSS File -->
    <link href="/assets/css/style.css" rel="stylesheet" />
  </head>

  <body>
    <main id="main">
      <!-- ======= Breadcrumbs ======= -->
      <section id="breadcrumbs" class="breadcrumbs">
        <div class="container">
          <div class="d-flex justify-content-between align-items-center">
            <h2>Імплантація зубів</h2>
            <ol>
              <li><a href="/">Головна</a></li>
              <li>Імплантація зубів</li>
            </ol>
          </div>
        </div>
      </section><!-- End Breadcrumbs -->

      <!-- ======= Portfolio Details Section ======= -->
      <section id="portfolio-details" class="portfolio-details">
        <div class="container">
          <div class="row gy-4">
            <div class="col-lg-8">
              <img
                src="/assets/img/portfolio/implant-1.jpg"
                alt=""
                class="img-fluid"
              />
            </div>

            <div class="col-lg-4">
              <div class="portfolio-info">
                <h3>Імплантація зубів</h3>
                <ul>
                  <!-- TODO: move to variables -->
                  <li><strong>від 14 000 грн.</strong></li>
                </ul>
                <h3 class="mt-5">Записатися на прийом</h3>
                <FormSection />
              </div>
              <div class="portfolio-description">
                <h2>Імплантація зубів</h2>
                <p>
                  імплантанти заміщають собою корені втрачених зубів і
                  дозволяють, у перспективі, провести відновлення зубного ряду
                </p>
              </div>
            </div>
          </div>
        </div>
      </section><!-- End Portfolio Details Section -->
    </main><!-- End #main -->

    <!-- ======= Footer ======= -->
    <footer id="footer" class="bg-gray">
      <div class="container">
        <div class="row d-flex align-items-center">
          <div class="col-lg-6 text-lg-left text-center">
            <div class="copyright">
              &copy; Copyright 2021. Всі права захищені
            </div>
            <div class="credits"></div>
          </div>
          <div class="col-lg-6"></div>
        </div>
      </div>
    </footer><!-- End Footer -->

    <a
      href="#"
      class="back-to-top d-flex align-items-center justify-content-center"
      ><i class="bi bi-arrow-up-short"></i></a
    >

    <LoadScripts />
  </body>
</html>
