---
import FormSection from "@/components/FormSection/FormSection.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
---

<BaseLayout
  title="Ортодонтія - Dental Magic Studio"
  description="Ортодонтія в Одесі | Dental Magic Studio"
  keywords="Ортодонтія, стоматологія, Dental Magic Studio, Одеська область, Україна"
  alternateUrl="https://drkravchenko.com.ua/ortodontiya"
>
  <main id="main">
    <!-- ======= Breadcrumbs ======= -->
    <section id="breadcrumbs" class="breadcrumbs">
      <div class="container">
        <div class="d-flex justify-content-between align-items-center">
          <h2>Ортодонтія</h2>
          <ol>
            <li><a href="/">Головна</a></li>
            <li>Ортодонтія</li>
          </ol>
        </div>
      </div>
    </section><!-- End Breadcrumbs -->

    <!-- ======= Portfolio Details Section ======= -->
    <section id="portfolio-details" class="portfolio-details">
      <div class="container">
        <div class="row gy-4">
          <div class="col-lg-8">
            <img
              src="/assets/img/portfolio/brackets-2.jpg"
              alt=""
              class="img-fluid"
            />
          </div>

          <div class="col-lg-4">
            <div class="portfolio-info">
              <h3 class="mt-5">Записатися на прийом</h3>
              <FormSection />
            </div>
            <div class="portfolio-description">
              <h2>Ортодонтія</h2>
              <p>
                напрям стоматології, що займається виправленням прикусу та
                вирівнюванню зубного ряду
              </p>
            </div>
          </div>
        </div>
      </div>
    </section><!-- End Portfolio Details Section -->
  </main><!-- End #main -->

  <!-- ======= Footer ======= -->
  <footer id="footer" class="bg-gray">
    <div class="container">
      <div class="row d-flex align-items-center">
        <div class="col-lg-6 text-lg-left text-center">
          <div class="copyright">&copy; Copyright 2021. Всі права захищені</div>
          <div class="credits"></div>
        </div>
        <div class="col-lg-6"></div>
      </div>
    </div>
  </footer><!-- End Footer -->

  <a
    href="#"
    class="back-to-top d-flex align-items-center justify-content-center"
    ><i class="bi bi-arrow-up-short"></i></a
  >
</BaseLayout>
