---
import Header from "@/components/Header/Header.astro";
import { PHONE_NUMBER, PHONE_NUMBER_MASK } from "@/constants";
import BaseLayout from "@/layouts/BaseLayout.astro";
---

<BaseLayout
  title="Дякуємо за запис | Dental Magic Studio"
  description="Дякуємо за запис на прийом до стоматології Dental Magic Studio в Одесі"
  keywords="Дякуємо за запис, стоматологія, Dental Magic Studio, Одеська область, Україна"
  alternateUrl="https://drkravchenko.com.ua/dyakuyu-za-zapys"
>
  <Header />

  <main>
    <section class="thank-you-section">
      <div class="container">
        <div class="row justify-content-center text-center">
          <div class="col-md-8">
            <div class="thank-you-message">
              <h1 class="mb-4">Дякуємо за запис!</h1>
              <p class="lead mb-4 text-dark">
                Ми отримали ваш запит на запис до стоматолога. Наш менеджер
                зв'яжеться з вами найближчим часом для підтвердження запису.
              </p>
              <p class="contact-info mb-4 text-dark">
                Якщо у вас виникли питання, ви можете зв'язатися з нами за
                телефоном:
                <br />
                <a href={`tel:${PHONE_NUMBER}`} class="text-primary"
                  >{PHONE_NUMBER_MASK}</a
                >
              </p>
              <div class="mt-5">
                <a href="/" class="button">Повернутися на головну</a>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>

  <!-- ======= Footer ======= -->
  <footer id="footer" class="bg-gray">
    <div class="container">
      <div class="row d-flex align-items-center">
        <div class="col-lg-6 text-lg-left text-center">
          <div class="copyright">&copy; Copyright 2021. Всі права захищені</div>
          <div class="credits"></div>
        </div>
        <div class="col-lg-6"></div>
      </div>
    </div>
  </footer><!-- End Footer -->

  <style>
    .thank-you-section {
      --header-height: 117px;
      --header-height-mobile: 80px;
      --footer-height: 91px;

      display: flex;
      align-items: center;
      justify-content: center;
      height: calc(100vh - var(--header-height) - var(--footer-height));
      margin-top: var(--header-height);
      padding: 0;

      @media (max-width: 768px) {
        --header-height: var(--header-height-mobile);
      }
    }

    .thank-you-message {
      padding: 40px;
      border-radius: 10px;
      box-shadow: 0 0 20px rgba(0, 0, 0, 0.1);
    }

    .contact-info {
      font-size: 1.1em;
    }

    .button {
      font-family: "Roboto Condensed", sans-serif;
      font-weight: 400;
      font-size: 1.2rem;
      letter-spacing: 1px;
      display: inline-block;
      padding: 10px 30px;
      border-radius: 0.25rem;
      transition: 0.5s;
      color: var(--white);
      border: 1px solid var(--button);
      background: var(--button);
      cursor: pointer;
    }

    .button:hover {
      background: var(--white);
      border: 1px solid var(--white);
      color: var(--black);
    }
  </style>
</BaseLayout>
