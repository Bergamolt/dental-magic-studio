---
import Header from "@/components/Header/Header.astro";
import LoadScripts from "@/components/LoadScripts.astro";
import { PHONE_NUMBER, PHONE_NUMBER_MASK } from "@/constants";
---

<!doctype html>
<html lang="uk-UA">
  <head>
    <meta charset="utf-8" />
    <meta content="width=device-width, initial-scale=1.0" name="viewport" />

    <title>Дякуємо за запис | Dental Magic Studio</title>
    <meta
      content="Дякуємо за запис на прийом до стоматології Dental Magic Studio в Одесі"
      name="description"
    />

    <meta name="robots" content="noindex" />

    <link
      rel="alternate"
      hreflang="uk-UA"
      href="https://drkravchenko.com.ua/dyakuyu-za-zapys"
    />

    <!-- Favicons -->
    <link href="/assets/img/favicon.png" rel="icon" />
    <link href="/assets/img/apple-touch-icon.png" rel="apple-touch-icon" />

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Roboto+Condensed:wght@300;400&family=Yanone+Kaffeesatz:wght@200;400&display=swap"
      rel="stylesheet"
    />

    <!-- Vendor CSS Files -->
    <link
      href="/assets/vendor/bootstrap/css/bootstrap.min.css"
      rel="stylesheet"
    />
    <link
      href="/assets/vendor/bootstrap-icons/bootstrap-icons.css"
      rel="stylesheet"
    />

    <!-- Template Main CSS File -->
    <link href="/assets/css/style.css" rel="stylesheet" />
  </head>

  <body>
    <Header />

    <main>
      <section class="thank-you-section">
        <div class="container">
          <div class="row justify-content-center text-center">
            <div class="col-md-8">
              <div class="thank-you-message">
                <h1 class="mb-4">Дякуємо за запис!</h1>
                <p class="lead mb-4 text-dark">
                  Ми отримали ваш запит на запис до стоматолога. Наш менеджер
                  зв'яжеться з вами найближчим часом для підтвердження запису.
                </p>
                <p class="contact-info mb-4 text-dark">
                  Якщо у вас виникли питання, ви можете зв'язатися з нами за
                  телефоном:
                  <br />
                  <a href={`tel:${PHONE_NUMBER}`} class="text-primary"
                    >{PHONE_NUMBER_MASK}</a
                  >
                </p>
                <div class="mt-5">
                  <a href="/" class="button">Повернутися на головну</a>
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>
    </main>

    <!-- ======= Footer ======= -->
    <footer id="footer" class="bg-gray">
      <div class="container">
        <div class="row d-flex align-items-center">
          <div class="col-lg-6 text-lg-left text-center">
            <div class="copyright">
              &copy; Copyright 2021. Всі права захищені
            </div>
            <div class="credits"></div>
          </div>
          <div class="col-lg-6"></div>
        </div>
      </div>
    </footer><!-- End Footer -->

    <LoadScripts />

    <style>
      .thank-you-section {
        --header-height: 117px;
        --header-height-mobile: 80px;
        --footer-height: 91px;

        display: flex;
        align-items: center;
        justify-content: center;
        height: calc(100vh - var(--header-height) - var(--footer-height));
        margin-top: var(--header-height);
        padding: 0;

        @media (max-width: 768px) {
          --header-height: var(--header-height-mobile);
        }
      }

      .thank-you-message {
        padding: 40px;
        border-radius: 10px;
        box-shadow: 0 0 20px rgba(0, 0, 0, 0.1);
      }

      .contact-info {
        font-size: 1.1em;
      }

      .button {
        font-family: "Roboto Condensed", sans-serif;
        font-weight: 400;
        font-size: 1.2rem;
        letter-spacing: 1px;
        display: inline-block;
        padding: 10px 30px;
        border-radius: 0.25rem;
        transition: 0.5s;
        color: var(--white);
        border: 1px solid var(--button);
        background: var(--button);
        cursor: pointer;
      }

      .button:hover {
        background: var(--white);
        border: 1px solid var(--white);
        color: var(--black);
      }
    </style>
  </body>
</html>
