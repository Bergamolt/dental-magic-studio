---
import FormSection from "@/components/FormSection/FormSection.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
---

<BaseLayout
  title="Протезування Зубів - Лікарів Кравченко"
  description="Протезування Зубів в Одесі | Лікарів Кравченко"
  keywords="Протезування Зубів, Лікарів Кравченко, Одеська область, Україна"
  alternateUrl="https://drkravchenko.com.ua/protezuvannya-zubiv"
>
  <main id="main">
    <!-- ======= Breadcrumbs ======= -->
    <section id="breadcrumbs" class="breadcrumbs">
      <div class="container">
        <div class="d-flex justify-content-between align-items-center">
          <h2>Протезирование зубов</h2>
          <ol>
            <li><a href="/">Головна</a></li>
            <li>Протезування зубів</li>
          </ol>
        </div>
      </div>
    </section><!-- End Breadcrumbs -->

    <!-- ======= Portfolio Details Section ======= -->
    <section id="portfolio-details" class="portfolio-details">
      <div class="container">
        <div class="row gy-4">
          <div class="col-lg-8">
            <img
              src="/assets/img/portfolio/protez-1.jpg"
              alt=""
              class="img-fluid"
            />
          </div>

          <div class="col-lg-4">
            <div class="portfolio-info">
              <h3>Протезування зубів</h3>
              <ul>
                <!-- TODO: move to variables -->
                <li><strong>від 7 000 грн.</strong>: коронка (за зуб)</li>
                <li>
                  <strong>від 14 000 грн.</strong>: частково знімний або повний
                  знімний протез
                </li>
                <li><strong>від 15 000 грн.</strong>: бюгельний протез</li>
              </ul>
              <h3 class="mt-5">Записатися на прийом</h3>

              <FormSection />
              <div class="portfolio-description">
                <h2>Протезування зубів</h2>
                <p>
                  це шанс кожної людини відновити прогалини в зубному ряді,
                  знайти гарну посмішку та уникнути проблем зі здоров'ям
                </p>
              </div>
            </div>
          </div>
        </div>
      </div><!-- End Portfolio Details Section -->
    </section><!-- End #main -->

    <!-- ======= Footer ======= -->
    <footer id="footer" class="bg-gray">
      <div class="container">
        <div class="row d-flex align-items-center">
          <div class="col-lg-6 text-lg-left text-center">
            <div class="copyright">
              &copy; Copyright 2021. Всі права захищені
            </div>
            <div class="credits"></div>
          </div>
          <div class="col-lg-6"></div>
        </div>
      </div>
    </footer><!-- End Footer -->

    <a
      href="#"
      class="back-to-top d-flex align-items-center justify-content-center"
      ><i class="bi bi-arrow-up-short"></i></a
    >
  </main></BaseLayout
>
