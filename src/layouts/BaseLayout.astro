---
import AnalyticsScripts from "@/components/AnalyticsScripts.astro";
import LoadScripts from "@/components/LoadScripts.astro";

type Props = {
  title: string;
  description: string;
  keywords: string;
  alternateUrl: string;
};

const { title, description, keywords, alternateUrl } = Astro.props;
---

<!doctype html>
<html lang="uk-UA">
  <head>
    <meta charset="utf-8" />
    <meta content="width=device-width, initial-scale=1.0" name="viewport" />

    <title>{title}</title>
    <meta content={keywords} name="keywords" />
    <meta content={description} name="description" />

    <link rel="alternate" hreflang="uk-UA" href={alternateUrl} />

    <!-- Favicons -->
    <link href="/assets/img/favicon.png" rel="icon" />
    <link href="/assets/img/apple-touch-icon.png" rel="apple-touch-icon" />

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Roboto+Condensed:wght@300;400&family=Yanone+Kaffeesatz:wght@200;400&display=swap"
      rel="stylesheet"
    />

    <!-- Vendor CSS Files -->
    <!-- <link href="/assets/vendor/aos/aos.css" rel="stylesheet" /> -->
    <link
      href="/assets/vendor/bootstrap/css/bootstrap.min.css"
      rel="stylesheet"
    />
    <link
      href="/assets/vendor/bootstrap-icons/bootstrap-icons.css"
      rel="stylesheet"
    />
    <link
      href="/assets/vendor/boxicons/css/boxicons.min.css"
      rel="stylesheet"
    />
    <link
      href="/assets/vendor/glightbox/css/glightbox.min.css"
      rel="stylesheet"
    />
    <link href="/assets/vendor/remixicon/remixicon.css" rel="stylesheet" />
    <link href="/assets/vendor/swiper/swiper-bundle.min.css" rel="stylesheet" />

    <!-- Template Main CSS File -->
    <link href="/assets/css/style.css" rel="stylesheet" />
    <AnalyticsScripts />
  </head>

  <body>
    <slot />
    <LoadScripts />
  </body>
</html>
